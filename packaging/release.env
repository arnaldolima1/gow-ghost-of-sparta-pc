# What PortableKit's release scripts need to know about this port
# (portablekit/scripts/release_macos.sh; see docs/RELEASING.md).
RELEASE_NAME=Sparta
RELEASE_SLUG=sparta
RELEASE_TARGET=SpartaNative
RELEASE_APP_ID=io.github.arnaldolima1.Sparta
RELEASE_SUMMARY="Play God of War: Ghost of Sparta natively from your own disc image"
RELEASE_URL=https://github.com/arnaldolima1/gow-ghost-of-sparta-pc
# The game loads no code overlays.
RELEASE_OVERLAYS=0
# Names that are this game's data and must never be packed (lower case).
RELEASE_GAME_NAMES="uces01401* eboot.* boot.bin *.iso"
